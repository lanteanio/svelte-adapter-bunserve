{
	"name": "svelte-adapter-bunserve",
	"version": "0.0.1",
	"description": "SvelteKit adapter for Bun - Bun.serve HTTP with the svelte-adapter-uws realtime DX, no native addon",
	"author": "Kevin Radziszewski",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lanteanio/svelte-adapter-bunserve.git"
	},
	"homepage": "https://github.com/lanteanio/svelte-adapter-bunserve#readme",
	"bugs": {
		"url": "https://github.com/lanteanio/svelte-adapter-bunserve/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.js"
		}
	},
	"files": [
		"src",
		"protocol.schema.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"probe": "bun probe/bun-api-facts.mjs",
		"test": "node --test \"test/unit/*.test.mjs\"",
		"test:live": "bun test/live/run.mjs",
		"check:publish": "publint && attw --pack . --profile esm-only",
		"probe:uws": "node probe/uws-surface.mjs"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-json": "^6.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"rollup": "^4.0.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"adapter",
		"bun",
		"bun.serve",
		"websocket",
		"realtime"
	],
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"publint": "^0.3.22"
	}
}
